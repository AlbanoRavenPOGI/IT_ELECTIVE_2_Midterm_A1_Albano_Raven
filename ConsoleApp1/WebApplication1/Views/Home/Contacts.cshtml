<section id="contact" class="container py-4 mb-5">
    <h2 class="fw-bold mb-4">
        Contact Me
    </h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Email</strong><br>@ViewData["Email"]</p>
                    <p><strong>Mobile</strong><br>@ViewData["Mobile"]</p>
                </div>
                <div class="col-md-6">
                    <p><strong>GitHub</strong><br>@ViewData["Github"]</p>
                    <p><strong>LinkedIn</strong><br>@ViewData["LinkedIn"]</p>
                    <p><strong>Facebook</strong><br>@ViewData["Facebook"]</p>
                </div>
            </div>
            <a class="btn btn-dark mt-3">
                Download Resume
            </a>
        </div>
    </div>
</section>