<section id="about" class="container py-4">
    <h2 class="fw-bold mb-4">
        About Me
    </h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <p>
                @ViewData["About"]
            </p>
            <p>
                @ViewData["AboutMe"]
            </p>
            <hr>
            <div class="row">
                <div class="col-md-4">
                    <h6 class="fw-bold">Education</h6>
                    <p>@ViewData["Education"]</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Career Goal</h6>
                    <p>@ViewData["CareerGoal"]</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Interests</h6>
                    <p>@ViewData["Interest"]</p>
